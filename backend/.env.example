# Copy this file to .env and fill in your values
# DO NOT commit .env to version control

# Server Configuration
PORT=5000
NODE_ENV=development

# MySQL / TiDB Cloud Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=seismoscan
# TiDB Cloud (production): set DB_PORT=4000 and configure ssl in database.js

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production_minimum_32_chars
JWT_EXPIRES_IN=24h

# File Upload Configuration
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=5242880

# Frontend URL(s) for CORS
# For multiple origins (e.g. Netlify + custom domain), comma-separate them:
#   FRONTEND_URL=https://seismoscan.netlify.app,https://www.seismoscan.com
FRONTEND_URL=http://localhost:3000
